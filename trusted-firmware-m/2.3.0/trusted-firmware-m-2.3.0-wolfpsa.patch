diff --git a/lib/ext/wolfpsa/psa_store_tfm.c b/lib/ext/wolfpsa/psa_store_tfm.c
new file mode 100644
index 000000000..ad380cb20
--- /dev/null
+++ b/lib/ext/wolfpsa/psa_store_tfm.c
@@ -0,0 +1,147 @@
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "psa_store.h"
+#include "psa/internal_trusted_storage.h"
+#include "psa/storage_common.h"
+
+/* wolfPSA's store is a stream (Open/Read/Write/Close) but ITS is whole object,
+ * so a slot buffers the object between Open and Close. One request is in flight
+ * per partition, hence a single static slot and no heap. */
+#ifndef WOLFPSA_STORE_MAX_OBJ
+#define WOLFPSA_STORE_MAX_OBJ 512
+#endif
+
+typedef struct {
+    psa_storage_uid_t uid;
+    uint8_t  buf[WOLFPSA_STORE_MAX_OBJ];
+    size_t   len;
+    size_t   pos;
+    int      in_use;
+    int      read;
+} wolfpsa_tfm_slot;
+
+static wolfpsa_tfm_slot g_slot;
+
+/* id1 is the key id, id2 the owner: both halves must select the object or two
+ * clients using the same key id would collide. */
+static psa_storage_uid_t wolfpsa_tfm_uid(int type, unsigned long id1,
+                                          unsigned long id2)
+{
+    return (((psa_storage_uid_t)(uint32_t)id2) << 32)
+           | ((psa_storage_uid_t)(uint32_t)id1)
+           | (((psa_storage_uid_t)(uint8_t)type) << 56);
+}
+
+int wolfPSA_Store_OpenSz(int type, unsigned long id1, unsigned long id2,
+                          int read, int variableSz, void** store)
+{
+    psa_storage_uid_t uid = wolfpsa_tfm_uid(type, id1, id2);
+    size_t got = 0;
+
+    (void)variableSz;
+
+    if (store == NULL) {
+        return -1;
+    }
+    if (g_slot.in_use != 0) {
+        return -1;
+    }
+
+    g_slot.uid = uid;
+    g_slot.pos = 0;
+    g_slot.len = 0;
+    g_slot.read = read;
+
+    if (read != 0) {
+        if (psa_its_get(uid, 0, sizeof(g_slot.buf), g_slot.buf, &got)
+            != PSA_SUCCESS) {
+            /* -4 is what the POSIX store returns for "no such object". */
+            return -4;
+        }
+        g_slot.len = got;
+    }
+
+    g_slot.in_use = 1;
+    *store = &g_slot;
+    return 0;
+}
+
+int wolfPSA_Store_Open(int type, unsigned long id1, unsigned long id2,
+                        int read, void** store)
+{
+    return wolfPSA_Store_OpenSz(type, id1, id2, read, 0, store);
+}
+
+int wolfPSA_Store_Read(void* store, unsigned char* buffer, int len)
+{
+    wolfpsa_tfm_slot* s = (wolfpsa_tfm_slot*)store;
+    size_t n;
+
+    if ((s == NULL) || (buffer == NULL) || (len < 0)) {
+        return -1;
+    }
+
+    n = s->len - s->pos;
+    if (n > (size_t)len) {
+        n = (size_t)len;
+    }
+    (void)memcpy(buffer, &s->buf[s->pos], n);
+    s->pos += n;
+    return (int)n;
+}
+
+int wolfPSA_Store_Write(void* store, unsigned char* buffer, int len)
+{
+    wolfpsa_tfm_slot* s = (wolfpsa_tfm_slot*)store;
+
+    if ((s == NULL) || (buffer == NULL) || (len < 0)) {
+        return -1;
+    }
+    if ((s->pos + (size_t)len) > sizeof(s->buf)) {
+        return -1;
+    }
+
+    (void)memcpy(&s->buf[s->pos], buffer, (size_t)len);
+    s->pos += (size_t)len;
+    if (s->pos > s->len) {
+        s->len = s->pos;
+    }
+    return len;
+}
+
+/* The ITS write happens here: wolfPSA streams the object out, and only a closed
+ * object is complete. */
+void wolfPSA_Store_Close(void* store)
+{
+    wolfpsa_tfm_slot* s = (wolfpsa_tfm_slot*)store;
+
+    if (s == NULL) {
+        return;
+    }
+
+    if ((s->read == 0) && (s->len > 0u)) {
+        (void)psa_its_set(s->uid, s->len, s->buf, PSA_STORAGE_FLAG_NONE);
+    }
+
+    (void)memset(s->buf, 0, sizeof(s->buf));
+    s->in_use = 0;
+    s->len = 0;
+    s->pos = 0;
+}
+
+int wolfPSA_Store_Remove(int type, unsigned long id1, unsigned long id2)
+{
+    psa_storage_uid_t uid = wolfpsa_tfm_uid(type, id1, id2);
+    psa_status_t status = psa_its_remove(uid);
+
+    /* -4 is "no such object"; the key store maps it to INVALID_HANDLE. */
+    if (status == PSA_ERROR_DOES_NOT_EXIST) {
+        return -4;
+    }
+    if (status != PSA_SUCCESS) {
+        return -1;
+    }
+    return 0;
+}
diff --git a/lib/ext/wolfpsa/user_settings.h b/lib/ext/wolfpsa/user_settings.h
new file mode 100644
index 000000000..ba5a4015f
--- /dev/null
+++ b/lib/ext/wolfpsa/user_settings.h
@@ -0,0 +1,93 @@
+#ifndef __WOLFPSA_TFM_USER_SETTINGS_H__
+#define __WOLFPSA_TFM_USER_SETTINGS_H__
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* wolfSSL builds gnu11 where anonymous inline aggregates are on; TF-M's
+ * toolchain forces -std=c99, which turns them off and silently shrinks WC_RNG. */
+#define HAVE_ANONYMOUS_INLINE_AGGREGATES 1
+
+#define WOLFCRYPT_ONLY
+#define SINGLE_THREADED
+#define WOLFSSL_PSA_ENGINE
+#define NO_FILESYSTEM
+#define NO_WRITEV
+#define WOLFSSL_NO_SOCK
+#define NO_ERROR_STRINGS
+#define NO_WOLFSSL_DIR
+#define WC_NO_HARDEN
+
+/* The crypto partition has no heap. */
+
+/* SP math: no x86 asm, no TomsFastMath, on Cortex-M33. SP_SMALL keeps ECC off
+ * the (shared SFN) stack budget - the unrolled SP path overflows it. */
+#define WOLFSSL_SP_MATH_ALL
+#define WOLFSSL_HAVE_SP_ECC
+#define WOLFSSL_SP_384
+#define HAVE_SP_ECC
+#define WOLFSSL_SP_NO_MALLOC
+#define WOLFSSL_SP_SMALL
+
+#define WOLFSSL_SHA224
+#define WOLFSSL_SHA256
+#define WOLFSSL_SHA384
+#define WOLFSSL_SHA512
+#define NO_MD4
+#define NO_DSA
+#define NO_RC4
+/* TF-M's crypto profile treats SHA-1 as unsupported; keep wolfCrypt in step. */
+#define NO_SHA
+/* wolfPSA's full PSA surface references these when live-linked. */
+#define WOLFSSL_MD5
+#define WOLFSSL_RIPEMD
+#define HAVE_PBKDF2
+#define NO_PKCS12
+
+/* Entropy: only the crypto server runs wolfCrypt's RNG. The partition has no
+ * TRNG wired, and the default OS seed path pulls getenv/stdio. Production MUST
+ * provide CUSTOM_RAND_GENERATE_SEED backed by platform entropy; bring-up on QEMU
+ * (no TRNG) opts in to a deterministic seed with WOLFPSA_TFM_ALLOW_TEST_ENTROPY.
+ * Header-only includers (wolfCOSE/attestation ABI sharing) don't run the RNG. */
+#if defined(CUSTOM_RAND_GENERATE_SEED)
+    /* Platform supplies a real entropy hook. */
+#elif defined(WOLFPSA_TFM_ALLOW_TEST_ENTROPY)
+    #define WOLFSSL_GENSEED_FORTEST
+#elif defined(WOLFPSA_CRYPTO_SERVER)
+    #error "wolfPSA/TF-M entropy: the crypto server needs CUSTOM_RAND_GENERATE_SEED (production) or WOLFPSA_TFM_ALLOW_TEST_ENTROPY (bring-up only)"
+#endif
+
+#define HAVE_ECC
+#define HAVE_ECC384
+#define HAVE_ECC_KEY_EXPORT
+#define HAVE_ECC_KEY_IMPORT
+#define ECC_TIMING_RESISTANT
+#define HAVE_HKDF
+#define WOLFSSL_CMAC
+#define WOLFSSL_AES_DIRECT
+#define HAVE_AESGCM
+#define HAVE_AESCCM
+#define WOLFSSL_AES_COUNTER
+#define WOLFSSL_AES_CFB
+#define WOLFSSL_AES_OFB
+#define WOLFSSL_KEY_GEN
+
+/* RSA for RSASSA-PSS verify and RSA-OAEP: SP math, 2048-bit. */
+#define WC_RSA_PSS
+#define WOLFSSL_HAVE_SP_RSA
+#define WOLFSSL_SP_2048
+/* wolfPSA's cipher/sign surface references DES3 and Ed448 when live-linked. */
