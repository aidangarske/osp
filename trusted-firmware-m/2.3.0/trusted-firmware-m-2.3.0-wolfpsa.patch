diff --git a/lib/ext/wolfpsa/CMakeLists.txt b/lib/ext/wolfpsa/CMakeLists.txt
new file mode 100644
index 000000000..3ca39c0c2
--- /dev/null
+++ b/lib/ext/wolfpsa/CMakeLists.txt
@@ -0,0 +1,132 @@
+if (NOT TFM_PARTITION_CRYPTO)
+    return()
+endif()
+
+cmake_minimum_required(VERSION 3.21)
+
+if (NOT WOLFPSA_PATH OR NOT EXISTS ${WOLFPSA_PATH})
+    message(FATAL_ERROR "WOLFPSA_PATH = '${WOLFPSA_PATH}' is not set or does not exist. "
+                        "Provide a wolfPSA checkout with -DWOLFPSA_PATH=")
+endif()
+if (NOT WOLFSSL_PATH OR NOT EXISTS ${WOLFSSL_PATH})
+    message(FATAL_ERROR "WOLFSSL_PATH = '${WOLFSSL_PATH}' is not set or does not exist. "
+                        "wolfPSA needs wolfCrypt. Use -DWOLFSSL_PATH=")
+endif()
+
+file(GLOB WOLFPSA_SOURCES ${WOLFPSA_PATH}/src/*.c)
+list(REMOVE_ITEM WOLFPSA_SOURCES ${WOLFPSA_PATH}/src/psa_store_posix.c)
+
+add_library(crypto_service_wolfpsa STATIC EXCLUDE_FROM_ALL)
+
+target_sources(crypto_service_wolfpsa
+    PRIVATE
+        ${WOLFPSA_SOURCES}
+        # ITS-backed persistence replaces the POSIX file store.
+        ${CMAKE_CURRENT_LIST_DIR}/psa_store_tfm.c
+        ${CMAKE_CURRENT_LIST_DIR}/wolfpsa_heap.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/wc_port.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/memory.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/misc.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/logging.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/error.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/wolfmath.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/sp_int.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/sp_c32.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/random.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/hash.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/sha.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/sha256.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/sha512.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/sha3.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/hmac.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/kdf.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/cmac.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/aes.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/ecc.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/rsa.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/asn.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/coding.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/signature.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/wc_encrypt.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/chacha.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/poly1305.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/chacha20_poly1305.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/curve25519.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/ed25519.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/fe_operations.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/ge_operations.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/des3.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/md5.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/ripemd.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/ed448.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/fe_448.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/ge_448.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/pwdbased.c
+        ${WOLFSSL_PATH}/wolfcrypt/src/wolfentropy.c
+)
+
+target_include_directories(crypto_service_wolfpsa
+    PUBLIC
+        ${WOLFPSA_PATH}
+        ${WOLFPSA_PATH}/wolfpsa
+        ${CMAKE_CURRENT_LIST_DIR}
+        ${WOLFSSL_PATH}
+        ${CMAKE_CURRENT_SOURCE_DIR}/../../../secure_fw/partitions/crypto
+        # tfm_builtin_key_loader.h only needs psa/crypto.h; the driver .c
+        # itself is mbedtls coupled and is not compiled.
+        ${CMAKE_CURRENT_SOURCE_DIR}/../../../secure_fw/partitions/crypto/psa_driver_api
+        # platform_crypto_keys reaches tfm_plat_crypto_keys.h through whichever
+        # crypto library target it links, so this target has to carry it too.
+        ${CMAKE_CURRENT_SOURCE_DIR}/../../../platform/include
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/../../../interface/include>
+    PRIVATE
+        ${WOLFPSA_PATH}/src
+)
+
+target_compile_definitions(crypto_service_wolfpsa
+    PUBLIC
+        WOLFSSL_USER_SETTINGS
+        WOLFPSA_KEY_ID_ENCODES_OWNER
+        # wolfpsa_trace() uses getenv/stdio, which a secure partition cannot link.
+        WOLFPSA_NO_TRACE
+        # TF-M runs crypto as a client/server PSA service, so the operation
+        # structs carry the IPC handle.
+        WOLFPSA_CRYPTO_CLIENT_SERVER
+        # Marks this as the server build: op structs keep their full context,
+        # while the client (interface) sees only the uint32_t IPC handle.
+        WOLFPSA_CRYPTO_SERVER
+        TFM_CRYPTO_BACKEND_WOLFPSA
+        # Selects the in-tree slot enum in tfm_builtin_key_loader.h; without it
+        # the header wants a per platform ids file that an521 does not ship.
+        $<$<BOOL:${PLATFORM_DEFAULT_CRYPTO_KEYS}>:PLATFORM_DEFAULT_CRYPTO_KEYS>
+        $<$<BOOL:${PLATFORM_DEFAULT_NV_SEED}>:PLATFORM_DEFAULT_NV_SEED>
+        # Fail closed by default: user_settings.h #errors on a crypto-server build
+        # with no entropy source. Emulators (QEMU, no TRNG) must EXPLICITLY pass
+        # -DWOLFPSA_TFM_ALLOW_TEST_ENTROPY=ON for a deterministic bring-up seed;
+        # production wires CUSTOM_RAND_GENERATE_SEED to a real TRNG instead.
+        $<$<BOOL:${WOLFPSA_TFM_ALLOW_TEST_ENTROPY}>:WOLFPSA_TFM_ALLOW_TEST_ENTROPY>
+)
+
+target_compile_options(crypto_service_wolfpsa
+    PRIVATE
+        ${COMPILER_CP_FLAG}
+        -Wno-unused-parameter
+        -Wno-unused-const-variable
+        # SHELL: keeps each -include as its own unit (CMake would otherwise
+        # deduplicate the repeated -include token and merge the paths).
+        # 1) our settings ahead of wolfPSA's own user_settings.h (bare-metal opts).
+        "SHELL:-include ${CMAKE_CURRENT_LIST_DIR}/user_settings.h"
+        # 2) crypto_spe.h renames wolfPSA's PSA symbols to tfpsacrypto__* (the same
+        #    shim the crypto service uses), so the service binds to wolfPSA rather
+        #    than recursing into the client IPC stub.
+        "SHELL:-include ${CMAKE_CURRENT_LIST_DIR}/../../../secure_fw/partitions/crypto/crypto_spe.h"
+)
+
+target_link_libraries(crypto_service_wolfpsa
+    PRIVATE
+        platform_s
+    PUBLIC
+        tfm_config
+)
+
+set_target_properties(crypto_service_wolfpsa PROPERTIES LINK_INTERFACE_MULTIPLICITY 3)
