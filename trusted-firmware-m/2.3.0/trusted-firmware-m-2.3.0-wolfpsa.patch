diff --git a/secure_fw/partitions/crypto/crypto_library_wolfpsa.c b/secure_fw/partitions/crypto/crypto_library_wolfpsa.c
new file mode 100644
index 000000000..7bc5b836e
--- /dev/null
+++ b/secure_fw/partitions/crypto/crypto_library_wolfpsa.c
@@ -0,0 +1,247 @@
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "tfm_log.h"
+#include "config_tfm.h"
+/* crypto_spe.h renames the PSA calls below to tfpsacrypto__* so they bind to
+ * wolfPSA's server implementation (a direct call), not the client IPC stub
+ * (which would psa_call into this partition and panic). */
+#include "crypto_spe.h"
+#include "psa/crypto.h"
+#include "psa/error.h"
+#include "crypto_library.h"
+#include "tfm_plat_crypto_keys.h"
+#include "psa_manifest/pid.h"
+
+#ifndef WOLFPSA_KEY_ID_ENCODES_OWNER
+#error "WOLFPSA_KEY_ID_ENCODES_OWNER must be set: the crypto service is a multi client PSA service"
+#endif
+
+#define WOLFPSA_MAX_BUILTIN_KEY_SIZE 96
+
+static char wolfpsa_version_full[] = "wolfPSA";
+
+/* Per-owner HKDF(HUK, info=owner) subkey, so no partition sees another's derived secret (matches the stock loader). */
+static psa_status_t wolfpsa_derive_per_owner(int32_t owner, psa_key_id_t key_id)
+{
+    psa_key_attributes_t raw_attr = PSA_KEY_ATTRIBUTES_INIT;
+    psa_key_attributes_t sub_attr = PSA_KEY_ATTRIBUTES_INIT;
+    psa_key_derivation_operation_t op = psa_key_derivation_operation_init();
+    wolfpsa_svc_key_id_t raw = wolfpsa_svc_key_id_make(TFM_SP_CRYPTO, key_id);
+    wolfpsa_svc_key_id_t per_owner = wolfpsa_svc_key_id_make(owner, key_id);
+    wolfpsa_svc_key_id_t imported = WOLFPSA_SVC_KEY_ID_INIT;
+    uint8_t subkey[WOLFPSA_MAX_BUILTIN_KEY_SIZE];
+    size_t key_bytes;
+    int32_t info_owner = owner;
+    psa_status_t status;
+
+#ifdef TFM_PARTITION_TEST_PS
+    /* PS test partition shares the real PS subkey; it calls ps_system_prepare directly. */
+    if (info_owner == TFM_SP_PS_TEST) {
+        info_owner = TFM_SP_PS;
+    }
+#endif
+
+    /* Already derived for this owner. */
+    status = psa_get_key_attributes(per_owner, &sub_attr);
+    if (status == PSA_SUCCESS) {
+        (void)psa_reset_key_attributes(&sub_attr);
+        return PSA_SUCCESS;
+    }
+
+    status = psa_get_key_attributes(raw, &raw_attr);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+    key_bytes = PSA_BITS_TO_BYTES(psa_get_key_bits(&raw_attr));
+    if (key_bytes > sizeof(subkey)) {
+        (void)psa_reset_key_attributes(&raw_attr);
+        return PSA_ERROR_INSUFFICIENT_MEMORY;
+    }
+
+    status = psa_key_derivation_setup(&op, PSA_ALG_HKDF(PSA_ALG_SHA_256));
+    if (status == PSA_SUCCESS) {
+        status = psa_key_derivation_input_key(&op,
+                     PSA_KEY_DERIVATION_INPUT_SECRET, raw);
+    }
+    if (status == PSA_SUCCESS) {
+        status = psa_key_derivation_input_bytes(&op,
+                     PSA_KEY_DERIVATION_INPUT_INFO,
+                     (const uint8_t *)&info_owner, sizeof(info_owner));
+    }
+    if (status == PSA_SUCCESS) {
+        status = psa_key_derivation_output_bytes(&op, subkey, key_bytes);
+    }
+    (void)psa_key_derivation_abort(&op);
+
+    if (status == PSA_SUCCESS) {
+        (void)psa_reset_key_attributes(&sub_attr);
+        sub_attr.id = per_owner;
+        psa_set_key_type(&sub_attr, psa_get_key_type(&raw_attr));
+        psa_set_key_bits(&sub_attr, psa_get_key_bits(&raw_attr));
+        psa_set_key_algorithm(&sub_attr, psa_get_key_algorithm(&raw_attr));
+        psa_set_key_usage_flags(&sub_attr, psa_get_key_usage_flags(&raw_attr));
+        status = psa_import_key(&sub_attr, subkey, key_bytes, &imported);
+    }
+
+    (void)memset(subkey, 0, sizeof(subkey));
+    (void)psa_reset_key_attributes(&raw_attr);
+    return status;
+}
+
+/* Materialise the per-owner subkey lazily, so the owner-0 fallback never hands out the raw key. */
+static void wolfpsa_ensure_derived_builtin(int32_t owner, psa_key_id_t key_id)
+{
+    const tfm_plat_builtin_key_policy_t *policy_table = NULL;
+    size_t number_of_policies;
+    size_t pol;
+
+    if (owner == TFM_SP_CRYPTO) {
+        return;
+    }
+
+    number_of_policies = tfm_plat_builtin_key_get_policy_table_ptr(&policy_table);
+    for (pol = 0; pol < number_of_policies; pol++) {
+        if ((policy_table[pol].key_id == key_id) &&
+            (policy_table[pol].per_user_policy == 0) &&
+            ((policy_table[pol].usage & PSA_KEY_USAGE_DERIVE) != 0)) {
+            (void)wolfpsa_derive_per_owner(owner, key_id);
+            break;
+        }
+    }
+}
+
+tfm_crypto_library_key_id_t tfm_crypto_library_key_id_init(int32_t owner,
+                                                           psa_key_id_t key_id)
+{
+    wolfpsa_ensure_derived_builtin(owner, key_id);
+    return wolfpsa_svc_key_id_make(owner, key_id);
+}
+
+char *tfm_crypto_library_get_info(void)
+{
+    return wolfpsa_version_full;
+}
+
+void tfm_crypto_library_get_library_key_id_set_owner(int32_t owner,
+                                                     psa_key_attributes_t *attr)
+{
+    wolfpsa_set_key_owner_id(attr, owner);
+}
+
+/* wolfPSA has no builtin key driver, so the platform's keys are read out with
+ * the loader in their descriptor and imported once at init. The material stays
+ * inside this partition. */
+static psa_status_t wolfpsa_import_one_builtin(int32_t owner,
+        psa_key_id_t key_id, psa_key_type_t type, psa_key_bits_t bits,
+        psa_algorithm_t alg, psa_key_usage_t usage,
+        const uint8_t *key_buf, size_t key_len)
+{
+    psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
+    wolfpsa_svc_key_id_t imported = WOLFPSA_SVC_KEY_ID_INIT;
+    psa_status_t status;
+
+    /* Volatile under (owner, key_id): wolfpsa_volatile_find() matches (owner,
+     * key_id) exactly before the owner-0 fallback, so each caller resolves to
+     * its own policy. See the id-not-psa_set_key_id note below. */
+    attr.id = wolfpsa_svc_key_id_make(owner, key_id);
+    psa_set_key_type(&attr, type);
+    psa_set_key_bits(&attr, bits);
+    psa_set_key_algorithm(&attr, alg);
+    psa_set_key_usage_flags(&attr, usage);
+
+    status = psa_import_key(&attr, key_buf, key_len, &imported);
+    if (status != PSA_SUCCESS) {
+        ERROR("[Crypto] Failed to import builtin key 0x%x owner %d\n",
+              (unsigned)key_id, (int)owner);
+    }
+    return status;
+}
+
+static psa_status_t wolfpsa_import_builtin_keys(void)
+{
+    const tfm_plat_builtin_key_descriptor_t *desc_table = NULL;
+    const tfm_plat_builtin_key_policy_t *policy_table = NULL;
+    uint8_t key_buf[WOLFPSA_MAX_BUILTIN_KEY_SIZE];
+    size_t number_of_keys;
+    size_t number_of_policies;
+    size_t idx;
+    size_t pol;
+    psa_status_t status = PSA_SUCCESS;
+
+    number_of_keys = tfm_plat_builtin_key_get_desc_table_ptr(&desc_table);
+    number_of_policies = tfm_plat_builtin_key_get_policy_table_ptr(&policy_table);
+
+    for (idx = 0; (status == PSA_SUCCESS) && (idx < number_of_keys); idx++) {
+        const tfm_plat_builtin_key_descriptor_t *desc = &desc_table[idx];
+        psa_key_bits_t key_bits = 0;
+        psa_algorithm_t alg = 0;
+        psa_key_type_t type = 0;
+        size_t key_len = 0;
+
+        if (desc->loader_key_func == NULL) {
+            continue;
+        }
+
+        if (desc->loader_key_func(desc->loader_key_ctx, key_buf,
+                                  sizeof(key_buf), &key_len, &key_bits,
+                                  &alg, &type) != TFM_PLAT_ERR_SUCCESS) {
+            status = PSA_ERROR_HARDWARE_FAILURE;
+            break;
+        }
+
+        /* Import one key per authorized owner with that owner's exact usage, not
+         * a union under owner 0. Unioning would let any caller inherit another
+         * partition's rights (e.g. a non-secure caller signing with the IAK,
+         * which the platform policy grants only to the attestation partition).
+         * Keys with no per-user policy import once under owner 0 (global).
+         * The id is set directly (not psa_set_key_id, which would promote the
+         * key to persistent and pull in ITS IPC during crypto init); keeping it
+         * volatile re-provisions it in RAM under the builtin id every boot. */
+        for (pol = 0; (status == PSA_SUCCESS) && (pol < number_of_policies);
+             pol++) {
+            if (policy_table[pol].key_id != desc->key_id) {
+                continue;
+            }
+            if (policy_table[pol].per_user_policy == 0) {
+                /* A global DERIVE builtin (HUK) stays under the crypto partition; non-DERIVE globals stay owner 0. */
+                int32_t import_owner = 0;
+                if ((policy_table[pol].usage & PSA_KEY_USAGE_DERIVE) != 0) {
+                    import_owner = TFM_SP_CRYPTO;
+                }
+                status = wolfpsa_import_one_builtin(import_owner, desc->key_id,
+                             type, key_bits, alg, policy_table[pol].usage,
+                             key_buf, key_len);
+            }
+            else {
+                size_t user;
+                for (user = 0; (status == PSA_SUCCESS) &&
+                     (user < policy_table[pol].per_user_policy); user++) {
+                    status = wolfpsa_import_one_builtin(
+                                 policy_table[pol].policy_ptr[user].user,
+                                 desc->key_id, type, key_bits, alg,
+                                 policy_table[pol].policy_ptr[user].usage,
+                                 key_buf, key_len);
+                }
+            }
+        }
+
+        (void)memset(key_buf, 0, sizeof(key_buf));
+    }
+
+    return status;
+}
+
+psa_status_t tfm_crypto_core_library_init(void)
+{
+    psa_status_t status;
+
+    status = psa_crypto_init();
+    if (status == PSA_SUCCESS) {
+        /* Safe now: with crypto_spe.h, psa_import_key binds to wolfPSA's server
+         * implementation directly rather than the client IPC stub. */
+        status = wolfpsa_import_builtin_keys();
+    }
+    return status;
+}
