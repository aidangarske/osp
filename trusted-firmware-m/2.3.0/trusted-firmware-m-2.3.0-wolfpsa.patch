diff --git a/lib/ext/wolfpsa/wolfpsa_heap.c b/lib/ext/wolfpsa/wolfpsa_heap.c
new file mode 100644
index 000000000..18e7e97c3
--- /dev/null
+++ b/lib/ext/wolfpsa/wolfpsa_heap.c
@@ -0,0 +1,139 @@
+#include <stddef.h>
+#include <stdint.h>
+
+/* wolfPSA's key store allocates key nodes from a heap the crypto partition does
+ * not otherwise have; this static pool stands in for it (the analogue of the
+ * mbedtls memory_buffer_alloc pool tfpsacrypto uses). A uint64_t backing array
+ * forces 8-byte alignment so wolfCrypt's block stores stay aligned. */
+#ifndef WOLFPSA_HEAP_SIZE
+#define WOLFPSA_HEAP_SIZE (128u * 1024u)
+#endif
+
+typedef struct wolfpsa_block {
+    struct wolfpsa_block* next;
+    size_t size;
+    int    free;
+} wolfpsa_block;
+
+#define WOLFPSA_HDR_SZ (((sizeof(wolfpsa_block)) + 7u) & ~((size_t)7u))
+
+static uint64_t       g_pool[WOLFPSA_HEAP_SIZE / sizeof(uint64_t)];
+static wolfpsa_block* g_head;
+
+static size_t wolfpsa_align8(size_t n)
+{
+    return (n + 7u) & ~((size_t)7u);
+}
+
+static void wolfpsa_heap_init(void)
+{
+    g_head = (wolfpsa_block*)(void*)g_pool;
+    g_head->next = NULL;
+    g_head->size = sizeof(g_pool) - WOLFPSA_HDR_SZ;
+    g_head->free = 1;
+}
+
+void *malloc(size_t size)
+{
+    wolfpsa_block* b;
+    wolfpsa_block* nb;
+    size_t need;
+
+    if (g_head == NULL) {
+        wolfpsa_heap_init();
+    }
+    if (size == 0u) {
+        return NULL;
+    }
+
+    need = wolfpsa_align8(size);
+    for (b = g_head; b != NULL; b = b->next) {
+        if ((b->free == 0) || (b->size < need)) {
+            continue;
+        }
+        /* Split only when the remainder can hold a header plus a payload. */
+        if (b->size >= (need + WOLFPSA_HDR_SZ + 8u)) {
+            nb = (wolfpsa_block*)(void*)((uint8_t*)b + WOLFPSA_HDR_SZ + need);
+            nb->next = b->next;
+            nb->size = b->size - need - WOLFPSA_HDR_SZ;
+            nb->free = 1;
+            b->next = nb;
+            b->size = need;
+        }
+        b->free = 0;
+        return (uint8_t*)b + WOLFPSA_HDR_SZ;
+    }
+    return NULL;
+}
+
+void free(void *ptr)
+{
+    wolfpsa_block* b;
+    wolfpsa_block* c;
+
+    if (ptr == NULL) {
+        return;
+    }
+
+    b = (wolfpsa_block*)(void*)((uint8_t*)ptr - WOLFPSA_HDR_SZ);
+    b->free = 1;
+
+    /* The list is address ordered and the pool stays contiguous, so a forward
+     * pass merges every run of adjacent free blocks. */
+    for (c = g_head; c != NULL; c = c->next) {
+        while ((c->free != 0) && (c->next != NULL) && (c->next->free != 0)) {
+            c->size += WOLFPSA_HDR_SZ + c->next->size;
+            c->next = c->next->next;
+        }
+    }
+}
+
+void *realloc(void *ptr, size_t size)
+{
+    wolfpsa_block* b;
+    void* n;
+    size_t old;
+    size_t i;
+
+    if (ptr == NULL) {
+        return malloc(size);
+    }
+    if (size == 0u) {
+        free(ptr);
+        return NULL;
+    }
+
+    b = (wolfpsa_block*)(void*)((uint8_t*)ptr - WOLFPSA_HDR_SZ);
+    old = b->size;
+    if (old >= wolfpsa_align8(size)) {
+        return ptr;
+    }
+
+    n = malloc(size);
+    if (n != NULL) {
+        for (i = 0u; i < old; i++) {
+            ((uint8_t*)n)[i] = ((uint8_t*)ptr)[i];
+        }
+        free(ptr);
+    }
+    return n;
+}
+
+void *calloc(size_t nmemb, size_t size)
+{
+    size_t total;
+    void* p;
+    size_t i;
+
+    if ((nmemb != 0u) && ((SIZE_MAX / nmemb) < size)) {
+        return NULL;
+    }
+    total = nmemb * size;
+    p = malloc(total);
+    if (p != NULL) {
+        for (i = 0u; i < total; i++) {
+            ((uint8_t*)p)[i] = 0u;
+        }
+    }
+    return p;
+}
